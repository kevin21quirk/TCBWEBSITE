# Email delivery for the contact + newsletter forms.
# Sign up at https://resend.com, verify your domain, and set:
RESEND_API_KEY=re_xxxxxxxxxxxx

# Where enquiries are sent, and the verified sender address.
CONTACT_TO_EMAIL=hello@thecontractorbroker.com
CONTACT_FROM_EMAIL=website@thecontractorbroker.com

# Postgres connection string for the CRM (Neon dashboard -> Connection Details).
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require
