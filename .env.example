# Email delivery for the contact + newsletter forms.
# Sign up at https://resend.com, verify your domain, and set:
RESEND_API_KEY=re_xxxxxxxxxxxx

# All email — enquiries, lead outreach and reply links — goes to and from
# hello@thecontractorbroker.com, configured in src/lib/content.ts (site.email).

# Public site address used for the logo and links inside emails.
# Optional — defaults to the domain that served the form submission.
SITE_URL=https://thecontractorbroker.com

# Postgres connection string for the CRM (Neon dashboard -> Connection Details).
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require

# Lead Radar — searches the UK company register for recruitment agencies.
# Free REST API key from https://developer.company-information.service.gov.uk
COMPANIES_HOUSE_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
